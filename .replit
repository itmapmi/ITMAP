modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["chromium", "jq"]

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npx puppeteer browsers install chrome && npm run build"]
run = ["npm", "run", "start"]
ignorePorts = false

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5999
externalPort = 3003

[[ports]]
localPort = 8899
externalPort = 3001

[[ports]]
localPort = 23636
externalPort = 3000

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "traffic-analytics"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "teaser-funnel"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "traffic-analytics"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:traffic"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "teaser-funnel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run test:teaser-funnel"

[workflows.workflow.metadata]
isValidation = true

[agent]
integrations = ["javascript_object_storage:1.0.0", "javascript_openai_ai_integrations:2.0.0"]
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[userenv]

[userenv.shared]
REDDIT_PIXEL_ID = "a2_jm1855x77sag"
PUBLIC_BASE_URL = "https://itmap.ai"

